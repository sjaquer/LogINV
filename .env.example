# ═══════════════════════════════════════════════════════════════════
#  MolinoINV – Variables de entorno
# ═══════════════════════════════════════════════════════════════════
#  Copia este archivo como .env.local y reemplaza los valores.
#  Firebase Console → Project Settings → General → Your apps → SDK
# ═══════════════════════════════════════════════════════════════════

# Firebase Configuration
# Auth: Firebase Console → Authentication → Sign-in method → habilita
# "Correo electrónico/contraseña". El login de la app es solo correo +
# contraseña; las cuentas se crean desde /admin/users (rol admin) o con
# `npm run create-admin` para la primera cuenta (ver más abajo).
NEXT_PUBLIC_FIREBASE_PROJECT_ID="tu-project-id"
NEXT_PUBLIC_FIREBASE_APP_ID="tu-app-id"
NEXT_PUBLIC_FIREBASE_API_KEY="tu-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="tu-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="tu-sender-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="tu-project.appspot.com"

# Google Drive (fotos de productos) — flujo SEPARADO del login de la app.
# Al subir/cambiar una foto se pide iniciar sesión con Google (con el scope
# drive.file); no requiere Client ID aparte, solo que la Google Drive API
# esté habilitada en el mismo proyecto de Google Cloud vinculado a Firebase
# (APIs & Services → Library → Google Drive API → Enable).

# Firebase Admin SDK (SOLO SERVIDOR — nunca exponer con prefijo NEXT_PUBLIC_)
# Usado por /api/admin/users para crear/editar/eliminar cuentas de acceso y
# por `npm run create-admin`. Obtén estas credenciales en:
# Firebase Console → Configuración del proyecto → Cuentas de servicio →
# Generar nueva clave privada (descarga un JSON con estos 3 campos).
FIREBASE_ADMIN_PROJECT_ID="tu-project-id"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@tu-project-id.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Mock data toggle
# Cambiar a 'true' para usar datos de demostración sin Firebase
NEXT_PUBLIC_USE_MOCK=false
