// ═══════════════════════════════════════════════════════════════════════════
//  Firestore Security Rules - LogINV Bar
// ═══════════════════════════════════════════════════════════════════════════
//
//  INSTRUCCIONES:
//  1. Ve a Firebase Console → https://console.firebase.google.com
//  2. Selecciona tu proyecto: studio-6382721178-dadde
//  3. Ve a Firestore Database → Rules
//  4. Copia y pega estas reglas
//  5. Haz click en "Publish"
//
//  NOTA: Esta app usa autenticación local por PIN (sin Firebase Auth).
//  Las reglas validan la estructura y tamaño de los datos para prevenir
//  escrituras maliciosas, pero no restringen por usuario autenticado.
//  Si en el futuro integras Firebase Auth, agrega `request.auth != null`
//  a cada regla de read/write.
//
//  COLECCIONES:
//    productos      – Inventario de productos por ubicación
//    categorias     – Categorías de productos
//    movimientos    – Log inmutable de movimientos de stock
//    conteos        – Conteos diarios de inventario físico
//    requerimientos – Solicitudes de compra / reposición
//
//  UBICACIONES VÁLIDAS: BAR_1, BAR_2, ALMACEN
//
// ═══════════════════════════════════════════════════════════════════════════

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funciones auxiliares ─────────────────────────────────────────────

    // Limitar cantidad de campos del documento (previene abuso)
    function docSizeOk() {
      return request.resource.data.keys().size() < 30;
    }

    // Validar que un campo string no exceda cierta longitud (tolerante si el campo no existe)
    function strLenOk(field, maxLen) {
      return !request.resource.data.keys().hasAny([field])
             || (request.resource.data[field] is string && request.resource.data[field].size() <= maxLen);
    }

    // Validar que un campo numérico esté en rango (tolerante si el campo no existe)
    function numRangeOk(field, minVal, maxVal) {
      return !request.resource.data.keys().hasAny([field])
             || (request.resource.data[field] is number
                 && request.resource.data[field] >= minVal
                 && request.resource.data[field] <= maxVal);
    }

    // Validar ubicación válida
    function ubicacionValida(field) {
      return !request.resource.data.keys().hasAny([field])
             || request.resource.data[field] in ['BAR_1', 'BAR_2', 'ALMACEN'];
    }

    // ── Productos ───────────────────────────────────────────────────────
    //  Campos requeridos: nombre, categoria, stock_actual, ubicacion
    //  Campos opcionales: stock_minimo_rop, unidad, codigo_barras, lote,
    //                     fecha_vencimiento, ultima_actualizacion, fecha_creacion, activo
    match /productos/{productoId} {
      allow read: if true;

      allow create: if docSizeOk()
                    && request.resource.data.keys().hasAll(['nombre', 'categoria', 'stock_actual', 'ubicacion'])
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 0
                    && request.resource.data.nombre.size() <= 200
                    && request.resource.data.categoria is string
                    && request.resource.data.categoria.size() <= 100
                    && request.resource.data.stock_actual is number
                    && request.resource.data.stock_actual >= 0
                    && request.resource.data.stock_actual <= 999999
                    && request.resource.data.ubicacion in ['BAR_1', 'BAR_2', 'ALMACEN']
                    && numRangeOk('stock_minimo_rop', 0, 999999)
                    && strLenOk('codigo_barras', 50)
                    && strLenOk('unidad', 50)
                    && strLenOk('lote', 100);

      allow update: if docSizeOk()
                    && strLenOk('nombre', 200)
                    && strLenOk('categoria', 100)
                    && numRangeOk('stock_actual', 0, 999999)
                    && numRangeOk('stock_minimo_rop', 0, 999999)
                    && ubicacionValida('ubicacion')
                    && strLenOk('codigo_barras', 50)
                    && strLenOk('unidad', 50)
                    && strLenOk('lote', 100);

      allow delete: if true;
    }

    // ── Categorías ──────────────────────────────────────────────────────
    //  Campos requeridos: nombre
    //  Campos opcionales: descripcion, icono, color, orden, activa, fecha_creacion
    match /categorias/{categoriaId} {
      allow read: if true;

      allow create: if docSizeOk()
                    && request.resource.data.keys().hasAll(['nombre'])
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 0
                    && request.resource.data.nombre.size() <= 100
                    && strLenOk('descripcion', 300)
                    && strLenOk('icono', 10)
                    && strLenOk('color', 20)
                    && numRangeOk('orden', 0, 100);

      allow update: if docSizeOk()
                    && strLenOk('nombre', 100)
                    && strLenOk('descripcion', 300)
                    && strLenOk('icono', 10)
                    && strLenOk('color', 20)
                    && numRangeOk('orden', 0, 100);

      allow delete: if true;
    }

    // ── Movimientos de stock ────────────────────────────────────────────
    //  Campos requeridos: producto_id, tipo, cantidad
    //  Campos opcionales: producto_nombre, usuario, ubicacion, fecha,
    //                     stock_anterior, stock_nuevo, motivo, motivo_merma, notas
    //  Log inmutable — no se editan ni eliminan
    match /movimientos/{movimientoId} {
      allow read: if true;

      allow create: if docSizeOk()
                    && request.resource.data.keys().hasAll(['producto_id', 'tipo', 'cantidad'])
                    && request.resource.data.producto_id is string
                    && request.resource.data.tipo is string
                    && request.resource.data.tipo in ['INGRESO', 'SALIDA', 'MERMA', 'AJUSTE', 'CONTEO']
                    && request.resource.data.cantidad is number
                    && request.resource.data.cantidad >= 0
                    && request.resource.data.cantidad <= 999999
                    && ubicacionValida('ubicacion')
                    && strLenOk('producto_nombre', 200)
                    && strLenOk('nombre_producto', 200)
                    && strLenOk('usuario', 100)
                    && strLenOk('motivo', 500)
                    && strLenOk('motivo_merma', 500)
                    && strLenOk('notas', 500)
                    && numRangeOk('stock_anterior', 0, 999999)
                    && numRangeOk('stock_nuevo', 0, 999999);

      allow update: if false;
      allow delete: if false;
    }

    // ── Conteos de inventario ───────────────────────────────────────────
    //  Campos requeridos: usuario, estado, ubicacion
    //  Campos opcionales: fecha, items (array), notas, fecha_cierre
    //  Los conteos no se eliminan (historial)
    match /conteos/{conteoId} {
      allow read: if true;

      allow create: if docSizeOk()
                    && request.resource.data.keys().hasAll(['usuario', 'estado', 'ubicacion'])
                    && request.resource.data.usuario is string
                    && request.resource.data.usuario.size() <= 100
                    && request.resource.data.estado is string
                    && request.resource.data.estado in ['EN_PROGRESO', 'COMPLETADO']
                    && request.resource.data.ubicacion in ['BAR_1', 'BAR_2', 'ALMACEN']
                    && strLenOk('notas', 1000);

      allow update: if docSizeOk()
                    && strLenOk('usuario', 100)
                    && strLenOk('notas', 1000);

      allow delete: if false;
    }

    // ── Requerimientos (solicitudes de compra / reposición) ─────────────
    //  Campos requeridos: solicitante, estado
    //  Campos opcionales: items (array), logs (array), fecha_creacion
    match /requerimientos/{requerimientoId} {
      allow read: if true;

      allow create: if docSizeOk()
                    && request.resource.data.keys().hasAll(['solicitante', 'estado'])
                    && request.resource.data.solicitante is string
                    && request.resource.data.solicitante.size() <= 100
                    && request.resource.data.estado is string
                    && request.resource.data.estado in ['PENDIENTE', 'APROBADO_ADMIN', 'VALIDADO_GERENCIA', 'RECHAZADO', 'COMPRADO'];

      allow update: if docSizeOk()
                    && strLenOk('solicitante', 100);

      allow delete: if true;
    }

    // ── Denegar acceso a cualquier otra colección ───────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
