// ═══════════════════════════════════════════════════════════════════════════
//  Firestore Security Rules - LogINV Bar
// ═══════════════════════════════════════════════════════════════════════════
//
//  INSTRUCCIONES:
//  1. Ve a Firebase Console → https://console.firebase.google.com
//  2. Selecciona tu proyecto: studio-6382721178-dadde
//  3. Ve a Firestore Database → Rules
//  4. Copia y pega estas reglas
//  5. Haz click en "Publish"
//
//  NOTA: Esta app usa autenticación local por PIN (sin Firebase Auth).
//  Las reglas validan la estructura y tamaño de los datos para prevenir
//  escrituras maliciosas, pero no restringen por usuario autenticado.
//  Si en el futuro integras Firebase Auth, agrega `request.auth != null`
//  a cada regla de read/write.
//
// ═══════════════════════════════════════════════════════════════════════════

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funciones auxiliares ─────────────────────────────────────────────

    // Limitar tamaño del documento a ~50KB (previene abuso de almacenamiento)
    function docSizeOk() {
      return request.resource.data.keys().size() < 30;
    }

    // Validar que un campo string no exceda cierta longitud
    function strLenOk(field, maxLen) {
      return !request.resource.data.keys().hasAny([field])
             || (request.resource.data[field] is string && request.resource.data[field].size() <= maxLen);
    }

    // Validar que un campo numérico esté en rango
    function numRangeOk(field, minVal, maxVal) {
      return !request.resource.data.keys().hasAny([field])
             || (request.resource.data[field] is number
                 && request.resource.data[field] >= minVal
                 && request.resource.data[field] <= maxVal);
    }

    // ── Productos ───────────────────────────────────────────────────────
    match /productos/{productoId} {
      allow read: if true;

      allow create: if docSizeOk()
                    && request.resource.data.keys().hasAll(['nombre', 'categoria', 'stock_actual'])
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 0
                    && request.resource.data.nombre.size() <= 200
                    && request.resource.data.categoria is string
                    && request.resource.data.categoria.size() <= 100
                    && request.resource.data.stock_actual is number
                    && request.resource.data.stock_actual >= 0
                    && request.resource.data.stock_actual <= 999999
                    && numRangeOk('stock_minimo_rop', 0, 999999)
                    && strLenOk('codigo_barras', 50)
                    && strLenOk('unidad', 50)
                    && strLenOk('lote', 100)
                    && strLenOk('marca', 200)
                    && strLenOk('gramaje', 100)
                    && strLenOk('contenido', 200)
                    && strLenOk('proveedor', 200)
                    && strLenOk('descripcion', 500);

      allow update: if docSizeOk()
                    && strLenOk('nombre', 200)
                    && strLenOk('categoria', 100)
                    && numRangeOk('stock_actual', 0, 999999)
                    && numRangeOk('stock_minimo_rop', 0, 999999)
                    && strLenOk('codigo_barras', 50)
                    && strLenOk('unidad', 50)
                    && strLenOk('lote', 100)
                    && strLenOk('marca', 200)
                    && strLenOk('gramaje', 100)
                    && strLenOk('contenido', 200)
                    && strLenOk('proveedor', 200)
                    && strLenOk('descripcion', 500);

      allow delete: if true;
    }

    // ── Categorías ──────────────────────────────────────────────────────
    match /categorias/{categoriaId} {
      allow read: if true;

      allow create: if docSizeOk()
                    && request.resource.data.keys().hasAll(['nombre'])
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 0
                    && request.resource.data.nombre.size() <= 100
                    && strLenOk('descripcion', 300)
                    && strLenOk('icono', 10)
                    && strLenOk('color', 20);

      allow update: if docSizeOk()
                    && strLenOk('nombre', 100)
                    && strLenOk('descripcion', 300)
                    && strLenOk('icono', 10)
                    && strLenOk('color', 20);

      allow delete: if true;
    }

    // ── Movimientos de stock ────────────────────────────────────────────
    match /movimientos/{movimientoId} {
      allow read: if true;

      allow create: if docSizeOk()
                    && request.resource.data.keys().hasAll(['producto_id', 'tipo', 'cantidad'])
                    && request.resource.data.producto_id is string
                    && request.resource.data.tipo is string
                    && request.resource.data.tipo in ['INGRESO', 'SALIDA', 'MERMA', 'AJUSTE']
                    && request.resource.data.cantidad is number
                    && request.resource.data.cantidad >= 0
                    && request.resource.data.cantidad <= 999999
                    && strLenOk('nombre_producto', 200)
                    && strLenOk('usuario', 100)
                    && strLenOk('motivo_merma', 300)
                    && strLenOk('notas', 500);

      // Los movimientos son un log inmutable — no se editan ni eliminan
      allow update: if false;
      allow delete: if false;
    }

    // ── Conteos de inventario ───────────────────────────────────────────
    match /conteos/{conteoId} {
      allow read: if true;

      allow create: if docSizeOk()
                    && request.resource.data.keys().hasAll(['usuario', 'estado'])
                    && request.resource.data.usuario is string
                    && request.resource.data.usuario.size() <= 100
                    && request.resource.data.estado is string
                    && request.resource.data.estado in ['EN_PROGRESO', 'COMPLETADO']
                    && strLenOk('notas', 500);

      allow update: if docSizeOk()
                    && strLenOk('usuario', 100)
                    && strLenOk('notas', 500);

      allow delete: if false;
    }

    // ── Requerimientos (legacy, mantenido por compatibilidad) ───────────
    match /requerimientos/{requerimientoId} {
      allow read: if true;

      allow create: if docSizeOk()
                    && request.resource.data.keys().hasAll(['producto_id', 'estado'])
                    && request.resource.data.producto_id is string
                    && request.resource.data.estado is string
                    && strLenOk('notas', 500);

      allow update: if docSizeOk();
      allow delete: if true;
    }

    // ── Denegar acceso a cualquier otra colección ───────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
